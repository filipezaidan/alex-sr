# INTERFACES

ifconfig eth0 10.0.1.1/24    # LAN
ifconfig eth1 10.0.2.1/24    # DMZ
ifconfig eth2 10.0.3.1/24    # GERENCIAMENTO
ifconfig eth3 198.51.100.1/30 # WAN

# ROUTE
route add default gw 198.51.100.2


# INPUT / OUTPUT
# Regras que protegem o proprio firewall


# SSH - permite acesso ao firewall
iptables -A INPUT \
    -p tcp --dport 22 \
    -m conntrack --ctstate NEW,ESTABLISHED \
    -j ACCEPT

iptables -A OUTPUT \
    -p tcp --sport 22 \
    -m conntrack --ctstate ESTABLISHED \
    -j ACCEPT


# Loopback
iptables -A INPUT -i lo -j ACCEPT
iptables -A OUTPUT -o lo -j ACCEPT


# Conexoes ja estabelecidas
iptables -A INPUT \
    -m conntrack --ctstate ESTABLISHED,RELATED \
    -j ACCEPT

iptables -A OUTPUT \
    -m conntrack --ctstate ESTABLISHED,RELATED \
    -j ACCEPT


# Servicos oferecidos pelo proprio firewall
iptables -A INPUT -p tcp --dport 80 -j ACCEPT
iptables -A INPUT -p tcp --dport 443 -j ACCEPT


# Saida do proprio firewall
iptables -A OUTPUT -p udp --dport 53 -j ACCEPT
iptables -A OUTPUT -p tcp --dport 53 -j ACCEPT
iptables -A OUTPUT -p tcp --dport 80 -j ACCEPT
iptables -A OUTPUT -p tcp --dport 443 -j ACCEPT

# FORWARD

# Respostas de conexoes ja autorizadas
iptables -A FORWARD \
    -m conntrack --ctstate ESTABLISHED,RELATED \
    -j ACCEPT


# LAN -> DMZ
iptables -A FORWARD \
    -i eth0 -o eth1 \
    -m conntrack --ctstate NEW \
    -j ACCEPT

# LAN -> Internet
# HTTP e HTTPS novos só saem do Squid. O DROP vem antes do ACCEPT
# geral: sem ele, a regra larga deixaria o pc1 sair na porta 80.
iptables -A FORWARD \
    -i eth0 -o eth3 \
    -p tcp -s 10.0.1.20 --dport 80 \
    -m conntrack --ctstate NEW \
    -j ACCEPT

iptables -A FORWARD \
    -i eth0 -o eth3 \
    -p tcp -s 10.0.1.20 --dport 443 \
    -m conntrack --ctstate NEW \
    -j ACCEPT

iptables -A FORWARD \
    -i eth0 -o eth3 \
    -p tcp --dport 80 \
    -m conntrack --ctstate NEW \
    -j DROP

iptables -A FORWARD \
    -i eth0 -o eth3 \
    -p tcp --dport 443 \
    -m conntrack --ctstate NEW \
    -j DROP

# ICMP e o restante da LAN seguem como na atividade 1.
iptables -A FORWARD \
    -i eth0 -o eth3 \
    -m conntrack --ctstate NEW \
    -j ACCEPT

# Internet -> rp (DMZ). Destino fixo no NGINX: pacote novo para 10.0.2.10:80
# nao e mais aceito e cai na politica DROP. O trafego rp -> web nao passa
# pela FORWARD: os dois estao no mesmo cabo B, o switch entrega local.
iptables -A FORWARD \
    -i eth3 -o eth1 \
    -p tcp -d 10.0.2.20 --dport 80 \
    -m conntrack --ctstate NEW \
    -j ACCEPT

# DNS da DMZ -> Internet
iptables -A FORWARD \
    -i eth1 -o eth3 \
    -p udp --dport 53 \
    -m conntrack --ctstate NEW \
    -j ACCEPT

iptables -A FORWARD \
    -i eth1 -o eth3 \
    -p tcp --dport 53 \
    -m conntrack --ctstate NEW \
    -j ACCEPT

# POLITICA PADRAO

iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -P OUTPUT DROP